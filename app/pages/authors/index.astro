---
import { getCollection } from "astro:content";
import AuthorPopover from "../../components/AuthorPopover.astro";
import Icon from "../../components/Icon.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { authors } from "../../data/site";
import { postUrl, sortPosts } from "../../lib/content";
import { formatDate } from "../../lib/date";

const posts = sortPosts(await getCollection("posts"));
---

<SiteLayout
  title="作者"
  description="站点作者与创作者。"
  bodyClass="fly-authors-page"
>
  <div class="fly-content-shell">
    <div class="fly-authors-page-shell">
      <section class="fly-authors-hero" data-fly-reveal>
        <div class="fly-authors-hero-copy">
          <h1>作者</h1>
          <p>这个独立站点背后的写作者与维护者。</p>
        </div>
        <div class="fly-authors-hero-media">
          <img
            class="fly-authors-hero-image"
            src="/assets/images/authors-hero.webp"
            alt="作者"
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </section>

      <div class="fly-authors-directory">
        {
          authors.map((author, index) => {
            const authorPosts = posts
              .filter((post) => post.data.author === author.name)
              .slice(0, 6);
            const railId = `fly-authors-rail-${index}`;

            return (
              authorPosts.length > 0 && (
                <section
                  class="fly-authors-directory-section"
                  data-fly-carousel
                >
                  <header class="fly-authors-directory-header" data-fly-reveal>
                    <div class="fly-authors-profile-copy">
                      <div class="fly-authors-profile-name-row">
                        <img
                          class="fly-authors-profile-avatar"
                          src={author.avatar}
                          alt=""
                          width="46"
                          height="46"
                          loading="lazy"
                          decoding="async"
                        />
                        <h2>{author.name}</h2>
                      </div>
                      <p>{author.bio}</p>
                    </div>
                    <a
                      class="fly-section-view-link"
                      href={`/authors/${author.slug}/`}
                    >
                      <span>查看主页</span>
                      <Icon name="arrow-right" />
                    </a>
                  </header>

                  <div class="fly-authors-post-carousel">
                    <div
                      id={railId}
                      class="fly-authors-post-rail"
                      data-fly-carousel-rail
                      data-fly-reveal-group
                    >
                      {authorPosts.map((post) => (
                        <div
                          class="fly-authors-post-slide"
                          data-fly-carousel-item
                        >
                          <article class="fly-taxonomy-post-card fly-taxonomy-post-card--author-preview">
                            <div class="fly-taxonomy-post-media">
                              <a
                                class="fly-taxonomy-post-media-link"
                                href={postUrl(post)}
                                aria-label={`阅读：${post.data.title}`}
                              >
                                <img
                                  class="fly-taxonomy-post-cover"
                                  src={
                                    post.data.cover ||
                                    "/assets/images/fallback-cover.svg"
                                  }
                                  alt={post.data.title}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </a>
                            </div>
                            <div class="fly-taxonomy-post-body">
                              <AuthorPopover name={author.name} />
                              <h3 class="fly-taxonomy-post-title">
                                <a href={postUrl(post)}>{post.data.title}</a>
                              </h3>
                              <p class="fly-taxonomy-post-author">
                                {author.name}
                              </p>
                              <p class="fly-taxonomy-post-meta">
                                <time
                                  datetime={post.data.pubDate.toISOString()}
                                >
                                  {formatDate(post.data.pubDate)}
                                </time>
                              </p>
                            </div>
                          </article>
                        </div>
                      ))}
                    </div>
                    <button
                      class="fly-carousel-arrow fly-carousel-arrow--prev fly-authors-carousel-arrow"
                      type="button"
                      aria-label={`浏览${author.name}的上一篇文章`}
                      aria-controls={railId}
                      data-fly-carousel-prev
                    >
                      <Icon name="arrow-right" />
                    </button>
                    <button
                      class="fly-carousel-arrow fly-carousel-arrow--next fly-authors-carousel-arrow"
                      type="button"
                      aria-label={`浏览${author.name}的下一篇文章`}
                      aria-controls={railId}
                      data-fly-carousel-next
                    >
                      <Icon name="arrow-right" />
                    </button>
                  </div>
                </section>
              )
            );
          })
        }
      </div>
    </div>
  </div>
</SiteLayout>
