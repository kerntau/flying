---
import { getCollection } from "astro:content";
import Hero from "../../components/Hero.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { site } from "../../data/site";
import { formatDate } from "../../lib/date";

const moments = [...(await getCollection("moments"))].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const tags = Array.from(
  moments.reduce((result, moment) => {
    moment.data.tags.forEach((tag) => {
      result.set(tag, (result.get(tag) || 0) + 1);
    });
    return result;
  }, new Map<string, number>()),
);
---

<SiteLayout
  title="瞬间"
  description="记录日常里值得留存的片刻。"
  bodyClass="fly-moments"
>
  <div class="fly-content-shell fly-moments-shell">
    <div class="fly-moments-page">
      <Hero title="瞬间" description="记录日常里值得留存的片刻。" />
      <nav
        class="fly-moments-filter fly-horizontal-nav"
        data-fly-moments-filter
        aria-label="瞬间标签"
      >
        <div class="fly-moments-filter-rail fly-horizontal-nav-rail">
          <a
            class="fly-moments-filter-item fly-horizontal-nav-item"
            href="/moments/"
            data-fly-moment-tag>全部</a
          >
          {
            tags.map(([tag, count]) => (
              <a
                class="fly-moments-filter-item fly-horizontal-nav-item"
                href={`/moments/?tag=${encodeURIComponent(tag)}`}
                data-fly-moment-tag={tag}
              >
                <>
                  <span>{tag}</span>
                  <small>{count}</small>
                </>
              </a>
            ))
          }
        </div>
      </nav>
      <section class="fly-moments-feed" aria-label="瞬间列表">
        <div class="fly-moments-list" data-fly-moments-list>
          {
            moments.map((moment) => (
              <article
                class="fly-moment-card"
                data-fly-moment-card
                data-fly-moment-name={moment.id}
                data-fly-moment-tags={moment.data.tags.join("|")}
                data-fly-reveal
              >
                <header class="fly-moment-author">
                  <span class="fly-moment-author-avatar">
                    <img
                      src={site.logo}
                      alt={site.author}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <div class="fly-moment-author-copy">
                    <strong class="fly-moment-author-name">
                      {site.author}
                    </strong>
                    <a
                      class="fly-moment-author-time"
                      href={`/moments/${moment.id}/`}
                    >
                      <time datetime={moment.data.date.toISOString()}>
                        {formatDate(moment.data.date)}
                      </time>
                    </a>
                  </div>
                </header>
                <div class="fly-moment-body">
                  <p class="fly-moment-raw-text">{moment.data.content}</p>
                  {moment.data.tags.length > 0 && (
                    <nav class="fly-moment-tags" aria-label="瞬间标签">
                      {moment.data.tags.map((tag) => (
                        <a href={`/moments/?tag=${encodeURIComponent(tag)}`}>
                          #{tag}
                        </a>
                      ))}
                    </nav>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</SiteLayout>
