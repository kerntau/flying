---
import Icon from "./Icon.astro";
import { navigation, site } from "../data/site";
---

<div
  id="fly-navigation-popup"
  class="fly-navigation-popup"
  data-fly-navigation-popup
  aria-hidden="true"
  inert
>
  <button
    class="fly-navigation-backdrop"
    type="button"
    data-fly-menu-close
    aria-label="关闭菜单"></button>
  <aside
    class="fly-site-sidebar fly-site-sidebar--popup fly-navigation-panel"
    aria-label="弹出导航"
  >
    <header class="fly-navigation-panel-header">
      <button
        class="fly-icon-button fly-navigation-close"
        type="button"
        data-fly-menu-close
        aria-label="关闭菜单"
      >
        <Icon name="close" />
      </button>
      <a class="fly-brand fly-navigation-brand" href="/">{site.title}</a>
    </header>

    <div class="fly-sidebar-inner">
      <nav class="fly-sidebar-nav" aria-label="主导航">
        {
          navigation.map((item) => (
            <a
              class="fly-sidebar-link"
              href={item.href}
              aria-label={item.label}
            >
              <Icon name={item.icon} class="fly-menu-icon" />
              <span class="fly-nav-label">{item.label}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </aside>
</div>
