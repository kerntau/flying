---
import type { CollectionEntry } from "astro:content";
import { categoryUrl, makeSlug, postUrl } from "../lib/content";
import PostCard from "./PostCard.astro";

interface Props {
  posts: CollectionEntry<"posts">[];
  emptyText?: string;
  initialCount?: number;
}

const { posts, emptyText = "还没有文章。", initialCount } = Astro.props;
---

<div
  class="fly-article-grid fly-latest-grid"
  data-fly-feed
  data-fly-reveal-group
>
  {
    posts.length > 0 ? (
      posts.map((post, index) => (
        <PostCard
          title={post.data.title}
          url={postUrl(post)}
          date={post.data.pubDate}
          category={post.data.category}
          categorySlug={makeSlug(post.data.category)}
          categoryUrl={categoryUrl(post.data.category)}
          description={post.data.description}
          cover={post.data.cover}
          author={post.data.author}
          postName={post.id}
          pagedHidden={initialCount !== undefined && index >= initialCount}
        />
      ))
    ) : (
      <p class="fly-empty-state fly-empty-state--visible">{emptyText}</p>
    )
  }
</div>
