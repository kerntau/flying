---
import Icon from "./Icon.astro";
import { navigation, site, socialLinks } from "../data/site";
---

<aside
  id="fly-site-sidebar"
  class="fly-site-sidebar fly-site-sidebar--static"
  aria-label="站点导航"
>
  <div class="fly-sidebar-inner">
    <a class="fly-brand" href="/">{site.title}</a>
    <nav class="fly-sidebar-nav" aria-label="主导航">
      {
        navigation.map((item) => (
          <a
            class="fly-sidebar-link"
            href={item.href}
            aria-label={item.label}
            data-fly-tip={item.label}
          >
            <Icon name={item.icon} class="fly-menu-icon" />
            <span class="fly-nav-label">{item.label}</span>
          </a>
        ))
      }
    </nav>
  </div>

  <footer class="fly-sidebar-socials" aria-label="站点链接">
    <div class="fly-social-icons">
      {
        socialLinks.map((link) => (
          <a
            class="fly-social-icon"
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noopener" : undefined}
            aria-label={link.label}
            data-fly-tip={link.label}
          >
            <Icon name={link.icon} />
          </a>
        ))
      }
    </div>
    <p class="fly-footer-copyright">
      © {new Date().getFullYear()}
      {site.title}
    </p>
  </footer>
</aside>
