---
import SiteLayout from "../layouts/SiteLayout.astro";

const techStack = [
  "C",
  "Python",
  "JavaScript",
  "TypeScript",
  "HTML5",
  "CSS",
  "Vue.js",
  "Nuxt",
  "React",
  "Next.js",
  "Tailwind CSS",
  "PostCSS",
  "Headless UI",
  "Radix UI",
  "shadcn/ui",
  "Node.js",
  "MDX",
  "Markdown",
  "pnpm",
  "Git",
  "GitHub",
  "Java",
  "Go",
  "Rust",
  "C++",
  "Docker",
  "Nginx",
  "Redis",
  "MySQL",
  "MongoDB",
];
---

<SiteLayout
  title="关于"
  description="关于 Kerntau，一名记录网络安全学习、开发实践与技术笔记的信息安全专业学生。"
  image="/assets/images/avatar.png"
  bodyClass="fly-page"
>
  <div class="fly-content-shell fly-about-page">
    <section class="fly-about-profile" data-fly-reveal>
      <img
        src="/assets/images/avatar.png"
        alt="Kerntau 的头像"
        width="128"
        height="128"
      />
      <div>
        <h1>Kerntau</h1>
        <p>信息安全专业学生</p>
        <nav aria-label="Kerntau 的站外链接">
          <a href="mailto:coet.ink@qq.com">邮箱</a>
          <a
            href="https://github.com/kerntau"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          >
          <a
            href="https://v.douyin.com/HWMgjLaTtFk"
            target="_blank"
            rel="noopener noreferrer">抖音</a
          >
          <a
            href="https://space.bilibili.com/9655855"
            target="_blank"
            rel="noopener noreferrer">哔哩哔哩</a
          >
        </nav>
      </div>
    </section>

    <div class="fly-about-tech" aria-label="技术栈">
      {techStack.map((tech) => <span>{tech}</span>)}
    </div>

    <article class="fly-post-content fly-post-page-content fly-about-content">
      <h2>关于我</h2>
      <p>
        你好，我是 <strong>Kerntau</strong
        >，一名即将毕业的信息安全专业学生。这里主要记录我的网络安全学习心得、开发实践经历与技术笔记。
      </p>
      <p>
        除了信息安全领域的渗透测试与网络基础，我也热衷于 Web 开发，熟悉 C 与
        Python，常在 Linux / Windows 环境下折腾，目前主要使用 React 和 Nuxt
        等框架构建现代化的 Web 应用。
      </p>

      <h2>近期活动</h2>
      <ul>
        <li><strong>2026 年 4 月 - 至今</strong> · 在完成一件事。</li>
        <li><strong>2026 年 3 月</strong> · 使用 Nuxt 4 重构个人主站。</li>
        <li><strong>2026 年 2 月</strong> · 使用 React 重构个人博客。</li>
      </ul>

      <h2>鸣谢与开源规划</h2>
      <p>
        本站的开发离不开开源社区的启发，特别感谢以下大佬的开源项目与创意设计：
      </p>
      <ul class="fly-about-credits">
        <li>
          <a
            href="https://github.com/L33Z22L11"
            target="_blank"
            rel="noopener noreferrer">Zhilu</a
          >：<a
            href="https://github.com/L33Z22L11/blog-v3"
            target="_blank"
            rel="noopener noreferrer">blog-v3</a
          >（<a
            href="https://blog.zhilu.site/"
            target="_blank"
            rel="noopener noreferrer">blog.zhilu.site</a
          >）
        </li>
        <li>
          <a
            href="https://github.com/lxchapu"
            target="_blank"
            rel="noopener noreferrer">lxchapu</a
          >：<a
            href="https://github.com/lxchapu/astro-gyoza"
            target="_blank"
            rel="noopener noreferrer">astro-gyoza</a
          >（<a
            href="https://gyoza.lxchapu.com/"
            target="_blank"
            rel="noopener noreferrer">gyoza.lxchapu.com</a
          >）
        </li>
        <li>
          <a
            href="https://github.com/innei"
            target="_blank"
            rel="noopener noreferrer">innei</a
          >：<a
            href="https://github.com/innei/Shiro"
            target="_blank"
            rel="noopener noreferrer">Shiro</a
          >（<a
            href="https://innei.in/"
            target="_blank"
            rel="noopener noreferrer">innei.in</a
          >）
        </li>
      </ul>
      <p>
        当前博客已开源，欢迎关注仓库：<a
          href="https://github.com/kerntau/blog"
          target="_blank"
          rel="noopener noreferrer">kerntau/blog</a
        >。
      </p>
    </article>
  </div>
</SiteLayout>
