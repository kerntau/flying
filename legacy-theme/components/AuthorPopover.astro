---
import { authors, site } from "../data/site";

interface Props {
  name: string;
}

const { name } = Astro.props;
const author = authors.find((item) => item.name === name) || authors[0];
const profileHref = author ? `/authors/${author.slug}/` : "/authors/";
---

<div
  class="fly-author-popover-trigger fly-author-popover-trigger--named"
  data-fly-author-name={name}
  data-fly-author-permalink={profileHref}
  data-fly-author-avatar={author?.avatar || site.logo}
  data-fly-author-bio={author?.bio || ""}
  data-fly-author-qq=""
  data-fly-author-wechat=""
  data-fly-author-email="coet.ink@qq.com"
  data-fly-author-website={author?.website || ""}
>
  <a
    class="fly-author-popover-anchor"
    href={profileHref}
    aria-label={`查看作者：${name}`}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="fly-author-popover"
    data-fly-author-popover-anchor
  >
    <img
      src={author?.avatar || site.logo}
      alt=""
      width="28"
      height="28"
      loading="lazy"
      decoding="async"
    />
    <span class="fly-author-popover-label">{name}</span>
  </a>
</div>
