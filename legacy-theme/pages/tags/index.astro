---
import { getCollection } from "astro:content";
import Hero from "../../components/Hero.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getTags } from "../../lib/content";

const tags = getTags(await getCollection("posts"));
---

<SiteLayout
  title="标签"
  description="使用标签探索内容。"
  bodyClass="fly-taxonomy"
>
  <div class="fly-content-shell">
    <Hero
      title="标签"
      description="轻点标签，在分散的灵感之间找到同一条线索。"
    />
    <div class="fly-feed-controls" data-fly-reveal>
      {
        tags.map((tag) => (
          <a class="fly-filter-pill" href={`/tags/${tag.slug}/`}>
            #{tag.name} · {tag.count}
          </a>
        ))
      }
    </div>
  </div>
</SiteLayout>
