---
import type { CollectionEntry } from "astro:content";
import { site } from "../data/site";
import { categoryUrl, postUrl } from "../lib/content";
import { formatDate } from "../lib/date";
import Icon from "./Icon.astro";

interface Term {
  count: number;
  name: string;
  slug: string;
}

interface Props {
  posts: CollectionEntry<"posts">[];
  terms: Term[];
}

const { posts, terms } = Astro.props;
---

<div class="fly-taxonomy-sections">
  {
    terms.map((term) => {
      const termPosts = posts
        .filter((post) => post.data.category === term.name)
        .slice(0, 8);
      const railId = `fly-taxonomy-category-${term.slug}`;

      return (
        termPosts.length > 0 && (
          <section class="fly-taxonomy-section" data-fly-taxonomy-carousel>
            <header class="fly-taxonomy-section-header" data-fly-reveal>
              <div class="fly-taxonomy-section-header-copy">
                <h2>
                  <a href={categoryUrl(term.name)}>{term.name}</a>
                </h2>
                <p>共 {term.count} 篇文章</p>
              </div>
              <a
                class="fly-taxonomy-section-button"
                href={categoryUrl(term.name)}
              >
                查看全部
              </a>
            </header>
            <div class="fly-taxonomy-carousel">
              <div
                id={railId}
                class="fly-taxonomy-rail"
                data-fly-taxonomy-carousel-rail
                data-fly-reveal-group
              >
                {termPosts.map((post) => (
                  <div
                    class="fly-taxonomy-slide"
                    data-fly-taxonomy-carousel-item
                  >
                    <article class="fly-taxonomy-post-card">
                      <div class="fly-post-image-frame">
                        <a
                          class="fly-post-image-link"
                          href={postUrl(post)}
                          aria-label={`阅读：${post.data.title}`}
                        >
                          <img
                            class="fly-post-cover"
                            src={
                              post.data.cover ||
                              "/assets/images/fallback-cover.svg"
                            }
                            alt={post.data.title}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      </div>
                      <div class="fly-post-body">
                        <span class="fly-taxonomy-post-fallback-avatar">
                          <img src={site.logo} alt="" width="36" height="36" />
                        </span>
                        <h3 class="fly-post-title">
                          <a href={postUrl(post)}>{post.data.title}</a>
                        </h3>
                        <p class="fly-taxonomy-post-author">
                          {post.data.author}
                        </p>
                        <p class="fly-taxonomy-post-meta">
                          <time datetime={post.data.pubDate.toISOString()}>
                            {formatDate(post.data.pubDate)}
                          </time>
                        </p>
                      </div>
                    </article>
                  </div>
                ))}
              </div>
              <button
                class="fly-carousel-arrow fly-carousel-arrow--prev fly-taxonomy-carousel-arrow"
                type="button"
                aria-label={`浏览${term.name}的上一篇文章`}
                aria-controls={railId}
                data-fly-taxonomy-carousel-prev
              >
                <Icon name="arrow-right" />
              </button>
              <button
                class="fly-carousel-arrow fly-carousel-arrow--next fly-taxonomy-carousel-arrow"
                type="button"
                aria-label={`浏览${term.name}的下一篇文章`}
                aria-controls={railId}
                data-fly-taxonomy-carousel-next
              >
                <Icon name="arrow-right" />
              </button>
            </div>
          </section>
        )
      );
    })
  }
</div>
