---
import { getCollection } from "astro:content";
import PostGrid from "../../components/PostGrid.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { authors } from "../../data/site";
import { sortPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: {
      author,
      posts: sortPosts(
        posts.filter((post) => post.data.author === author.name),
      ),
    },
  }));
}

const { author, posts } = Astro.props;
---

<SiteLayout
  title={author.name}
  description={author.bio}
  image={author.avatar}
  bodyClass="fly-author"
>
  <div class="fly-content-shell">
    <section class="fly-taxonomy-hero" data-fly-reveal>
      <div class="fly-taxonomy-hero-copy">
        <h1>{author.name}</h1>
        <p>{author.bio}</p>
        <a
          class="fly-filter-pill"
          href={author.website}
          target="_blank"
          rel="noopener">个人网站</a
        >
      </div>
      <div class="fly-taxonomy-hero-media">
        <img
          class="fly-taxonomy-hero-image"
          src={author.avatar}
          alt={author.name}
        />
      </div>
    </section>
    <PostGrid posts={posts} emptyText="这位作者还没有文章。" />
  </div>
</SiteLayout>
