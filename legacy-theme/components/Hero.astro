---
interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/assets/images/taxonomy-hero.webp",
} = Astro.props;
---

<section class="fly-taxonomy-hero" data-fly-reveal>
  <div class="fly-taxonomy-hero-copy">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>

  <div class="fly-taxonomy-hero-media">
    <img
      class="fly-taxonomy-hero-image"
      src={image}
      alt={title}
      width="1600"
      height="900"
    />
  </div>
</section>
