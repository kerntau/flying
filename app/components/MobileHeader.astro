---
import ThemeSwitcher from "./theme/ThemeSwitcher.vue";
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<header class="fly-mobile-header">
  <div class="fly-navbar-brand">
    <button
      class="fly-icon-button fly-menu-button"
      type="button"
      data-fly-menu-toggle
      aria-label="打开菜单"
      aria-expanded="false"
      aria-controls="fly-navigation-popup"
    >
      <Icon name="menu" />
    </button>
    <a class="fly-brand fly-brand--mobile" href="/">{site.title}</a>
  </div>

  <button
    class="fly-navbar-search"
    type="button"
    data-fly-search-trigger
    aria-label="搜索文章"
  >
    <Icon name="search" class="fly-search-icon" />
    <span class="fly-search-placeholder">搜索文章</span>
    <kbd aria-hidden="true">/</kbd>
  </button>

  <ThemeSwitcher client:load />
</header>
