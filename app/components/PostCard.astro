---
import { formatDate } from "../lib/date";
import AuthorPopover from "./AuthorPopover.astro";

interface Props {
  title: string;
  url: string;
  date: Date;
  category?: string;
  categorySlug?: string;
  categoryUrl?: string;
  description?: string;
  cover?: string;
  author?: string;
  postName?: string;
  pagedHidden?: boolean;
}

const {
  title,
  url,
  date,
  category = "默认分类",
  categorySlug = "uncategorized",
  categoryUrl = "/categories/",
  description = "",
  cover = "/assets/images/fallback-cover.svg",
  author = "Handsome",
  postName = title,
  pagedHidden = false,
} = Astro.props;
---

<article
  class="fly-post-card"
  data-fly-post-card
  data-fly-post-name={postName}
  data-fly-category={categorySlug}
  data-fly-reveal
  data-fly-paged-hidden={pagedHidden ? "true" : undefined}
  hidden={pagedHidden}
>
  <div class="fly-post-image-frame">
    <a class="fly-post-image-link" href={url} aria-label={`阅读：${title}`}>
      <img
        class="fly-post-cover"
        src={cover}
        alt={title}
        loading="lazy"
        decoding="async"
      />
    </a>
    <a class="fly-post-chip fly-post-chip--image" href={categoryUrl}
      >{category}</a
    >
  </div>
  <div class="fly-post-body">
    <h2 class="fly-post-title">
      <a href={url}>{title}</a>
    </h2>
    {description && <p class="fly-post-excerpt">{description}</p>}

    <footer class="fly-post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </footer>
  </div>
</article>
